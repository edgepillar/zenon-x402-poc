# Default: local mock only
PAYMENT_MODE=mock
PORT=8402
RESOURCE_URL=http://127.0.0.1:8402/paid

# Live mode has no default profile. The only built-in option is an immutable,
# historical testnet observation selected under explicit operator trust. It is
# not a current-network release, authenticated RPC identity, or verified
# frontier lineage. Missing, altered, or mismatched selection and evidence fail
# before signing or publication.
#
# PAYMENT_MODE=zenon
# ZENON_CHAIN_PROFILE_NAME=historical-testnet-wiki-height-2-2021-12-17-v1
# ZENON_OPERATOR_TRUST_ACK=I_UNDERSTAND_THIS_ANCHOR_DOES_NOT_AUTHENTICATE_THE_CONNECTED_NODE
# X402_NETWORK=zenon:testnet
# ZENON_NETWORK_ID=3
# ZENON_RPC_URL=wss://testnet.zenonhub.io:35998
# ZENON_RPC_TIMEOUT_MS=10000
# ZENON_PAY_TO=z1_REPLACE_WITH_TESTNET_SELLER_ADDRESS
# ZENON_ASSET=ZNN
# ZENON_AMOUNT=1
# ZENON_MAX_TIMEOUT_SECONDS=60
# ZENON_MNEMONIC=replace with a disposable testnet mnemonic only
# ZENON_ACCOUNT_INDEX=0
# ZENON_LIVE_ACK=I_UNDERSTAND_TESTNET_ONLY

# ZENON_AMOUNT is a canonical positive atomic-unit decimal string. Its maximum
# is 2^255 - 1. Zero, signs, leading zeroes, fractions, exponents and whitespace
# are rejected.

# Never place a real mnemonic, private key, token or RPC credential in a file
# intended for publication.
