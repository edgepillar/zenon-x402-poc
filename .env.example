# Default: local mock only
PAYMENT_MODE=mock
PORT=8402
RESOURCE_URL=http://127.0.0.1:8402/paid

# Live mode cannot be enabled from this file alone. The repository ships no
# real chain profile and no connected-chain authenticator. server-cli.js does
# not inject either component, so PAYMENT_MODE=zenon fails closed by design.
#
# A future programmatic testnet integration may use the knobs below only after
# supplying and authenticating an explicit versioned chain profile. The label,
# configured SDK network ID and RPC self-reports do not authenticate a chain.
#
# PAYMENT_MODE=zenon
# X402_NETWORK=zenon:testnet
# ZENON_NETWORK_ID=3
# ZENON_RPC_URL=wss://testnet.zenonhub.io:35998
# ZENON_RPC_TIMEOUT_MS=10000
# ZENON_PAY_TO=z1_REPLACE_WITH_TESTNET_SELLER_ADDRESS
# ZENON_ASSET=ZNN
# ZENON_AMOUNT=1
# ZENON_MAX_TIMEOUT_SECONDS=60
# ZENON_MNEMONIC=replace with a disposable testnet mnemonic only
# ZENON_ACCOUNT_INDEX=0
# ZENON_LIVE_ACK=NO

# ZENON_AMOUNT is a canonical positive atomic-unit decimal string. Its maximum
# is 2^255 - 1. Zero, signs, leading zeroes, fractions, exponents and whitespace
# are rejected.

# Never place a real mnemonic, private key, token or RPC credential in a file
# intended for publication.
