  "selectedNames": {
    "builtin-exclusive-before-native": [
      "exclusive channel opens before one real lifecycle executes explicit original funding and service commands",
      "preparation plus EOF never supplies pins or starts funding handoff or service automatically",
      "concurrent same-stream invocation cannot enter a second native or key acquisition while first OPEN is pending",
      "reentrant same-stream invocation during native entry is refused before its opener",
      "native open rejection stops both owned streams without touching the unreturned key/client",
      "native synchronous open throw independently stops the channel without claiming key transfer",
      "unsupported opening thenable is refused without invoking its getter",
      "opening Promise constructor accessor is refused without assimilation",
      "session construction refusal stops the actually returned wallet/client and channel once",
      "previously prepared returned client is not adopted as a pristine funding session",
      "channel closure during pending OPEN prevents session transfer and stops the returned client",
      "failed returned-client close cannot suppress input and output stop",
      "pending returned-client close is retained while the owned channel completes its stop",
      "late output destroy completion cannot change the already rejected opening or repeat native close",
      "synchronously throwing stop still requests the independent channel stop",
      "returned-client inspection accessor is not invoked and cannot suppress actual owner stops",
      "inert configuration refusal leaves unacquired streams and native/key callbacks caller-owned"
    ],
    "builtin-opening-budget": [
      "pending funding OPEN expires and stops its later returned client once without transfer",
      "late client close rejection cannot change expired opening or repeat either stop",
      "late pending client stop remains retained after the owned channel has closed",
      "opening rejection after timeout is consumed without claiming an unreturned key stop",
      "synchronous native entry beyond deadline cannot transfer through the earlier Promise microtask",
      "returned client inspection beyond the whole opening budget refuses before session transfer",
      "successful transfer cancels the actual opening timer and retains ordinary session close",
      "early OPEN rejection cancels its long acquisition timer before channel cleanup completes",
      "opening budget accessor is refused inertly before ownership or native entry",
      "noninteger out of range and negative-zero opening budgets leave all resources caller owned",
      "throwing late returned-client stop cannot suppress channel closure or authorize a retry",
      "queued original commands cannot run or emit a result when native opening expires",
      "the fixed binding guard prevents fresh native acquisition after deferred module loading exceeds deadline",
      "deferred binding rechecks actual channel ownership before entering native acquisition"
    ]
  },
