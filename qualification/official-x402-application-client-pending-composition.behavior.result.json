    "entry": "qualification/official-x402-application-client-pending-composition.behavior.draft.mjs",
    "need": "The production one-shot scheme role existed, but actual official client/HTTP construction and spend-policy registration remained test-local. This opt-in module makes that exact assembly reusable without exposing mutable SDK state.",
    "publicMethods": [
      "decodePaymentRequiredHeader",
      "createPaymentPayload",
      "encodePaymentSignatureHeader",
      "getSnapshot"
    ],
    "behavior": [
      "Construct one actual pinned official client and HTTP adapter over the existing production one-shot bridge.",
      "Keep the SDK objects, registry, mutable hook/configuration surfaces and fixed spend policy private.",
      "Use one explicit asset/network and the fixed requirement amount as the per-asset atomic cap. Explicitly disable the unrelated default USD cap, not the asset cap.",
      "Preflight bounded descriptor-only input DATA without caller getters/proxies/toJSON. Reject malformed configuration and unsupported raw requirement fields before SDK construction.",
      "Decode one explicit canonical bounded PAYMENT-REQUIRED value; no body/v1 fallback or caller header-reader capability is exposed.",
      "Forward original challenge object identities and the actual HTTP-client Promise unchanged to the production bridge.",
      "Encode bounded structural v2 DATA for the fixed full requirement and return one PAYMENT-SIGNATURE string; no automatic transport or retry.",
      "Reuse the existing bridge's consumed-context, creator-ambiguity and finite context limits. Introduce no second payment owner or close lifecycle."
    ],
    "noNewDefault": "The separate module imports @x402/core/client only when explicitly imported. Active buyer/server/CLI entry points, package files, dependencies, workflows and existing production modules remain unchanged.",
    "policyBoundary": "A per-payment filter is not aggregate spending consent, authenticated token metadata, secure key custody or permission to attach a real signer.",
    "codecBoundary": "Headers and payloads remain structural DATA, not signature validation, instance-created provenance, original signed-byte custody, current authority or delivery evidence.",
    "dependencyBoundary": "The API is source-qualified for existing @x402/core 2.23.0 and Zod 3.25.76. A version label alone does not authenticate an installed package.",
    "lifetimeBoundary": "No fetch, transport, SDK recovery hook, cancellation or native resource owner is added. Pristine native/SDK components and trusted same-UID code remain premises."
  },
