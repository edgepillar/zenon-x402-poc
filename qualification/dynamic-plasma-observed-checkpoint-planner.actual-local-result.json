  "selection": {
    "roadmapLane": "P1-A original quote/context preservation through unsigned preparation",
    "positiveSourceAssociation": "The existing block-only planner awaited its first quote without exposing it and returned only assembly.accountBlock. The current original-checkpoint encoder requires the independent ORIGINAL plan and block. The new explicit preparation path retains that actual first quote/plan through the same work/material/assembly/final-read sequence and returns them together; it does not infer an original from a final block or manufacture another quote.",
    "existingBlockOnlyContract": "The old output was intentional, not a demonstrated vulnerability. The central ZenonTransactionPlanner SPI requires an AccountBlock. Therefore the new packet is exposed ONLY by prepareUnsignedCheckpoint and is rejected by assertZenonTransactionPlanner; it never masquerades as a block-returning planner.",
    "retainedComponentEvidence": {
      "path": "qualification/dynamic-plasma-observed-original-checkpoint.actual-local-result.json",
      "bytes": 19824,
      "LF": 466,
      "sha256": "d5dc1a782acadfb883ebc307465e767c3603ead618297c84c70655ea553e1f85",
      "gitBlob": "8dff82971d21fe7ec2572421c212ddcfa1272005"
    },
    "retainedEvidenceMeaning": "The prior six-case observed-checkpoint component result remains bound to its own exact graph. Its entry was not imported or replayed. The new cases exercise the real shared read-stage/preparation connection.",
    "missingCoverageIsNotNoveltyEvidence": true,
    "sourceOwnership": "Primary self-implementation, current-main blob checks and exact target/open-PR overlap review. No worker, automation, provider or model change.",
    "finiteScope": "Two existing source files, one new six-case entry and this result. One foreground Node command. Ten admitted fixed-data preparation attempts within the six tests, not ten additional authored tests.",
    "actionBoundary": "Existing fixed public bytes, literal zero-difficulty nonce and bounded local DATA callbacks only. No nonce search/producer, SDK, key generation, signature operation, SQLite, socket, real PREPARE, payment or live-pilot operation."
  },
  "api": {
    "factory": "createObservedBalanceDeferredMaterialCheckpointPreparer",
    "method": "prepareUnsignedCheckpoint",
    "options": "Same exact {readOptions:{transports,accountExchange}, materialExchange}; no caller factory, replacement plan/block or producer escape.",
    "context": "Exact plannerContextVersion:4 plus unchanged explicit observedUserSendReadVersion:3 UNSIGNED readInput.",
    "packet": "Frozen null-prototype DATA with originalPlan, same accountBlock, canonical checkpointJson and explicit NONE / NOT_ESTABLISHED authority boundaries.",
    "originalSequence": "First original quote -> original work request -> one native-Promise supplied-material handoff -> one assembly -> same original validation/checkpoint under final selected account/balance/DP brackets.",
    "readCycles": "Exactly the same four three-account-read cycles for success; checkpoint generation adds no fifth cycle. Existing one-wire/ten-cycle component budget stays in force.",
    "validationReuse": "The checkpoint read stage reuses the captured observed-original encoder's same existing unsigned validator instead of first invoking another redundant stage validator. Existing intent/hash/fixed-nonce/public-byte/price checks remain enforced.",
    "admission": "Same private busy/used state and native public run identity. One admitted operation including failure; wrong arity alone does not consume it. Direct self-material dependency is refused before assembly.",
    "legacy": "The existing named factory still requires plannerContextVersion:3 and exposes prepareUnsigned returning only AccountBlock. The old attempt file is unchanged; its captured sequence remains used for that branch.",
    "boundaries": "Neither a new preparation instance, a checkpoint, repeated DATA validation nor expiry grants consumed-authority reset, signing, replacement or publication permission.",
    "noDefaultBuyerSignerNativeOwnerOrStoreAdoption": true
  },
